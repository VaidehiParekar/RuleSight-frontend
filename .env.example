# Frontend environment configuration. Copy to `.env.local` for local overrides.
#
# SECURITY: every variable here must start with VITE_ and is embedded in the
# public browser bundle. Never put API keys, passwords or tokens in this file.

# Base URL of the RuleSight API. A relative path (default) is proxied to the
# backend in development by vite.config.ts; an absolute http(s) URL is also
# accepted. Must not contain credentials. Sign-in posts email + password to
# /auth/login and every request carries the returned JWT as "Authorization: Bearer".
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
